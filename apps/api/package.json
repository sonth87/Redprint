{
  "name": "@ui-builder/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npx --yes tsx watch --env-file=.env src/server.ts",
    "dev:plain": "npx --yes tsx --env-file=.env src/server.ts",
    "build": "tsc && npm run copy-data",
    "copy-data": "node --eval \"const fs=require('node:fs');for(const d of ['data/palette','data/content-packs']){fs.cpSync('src/'+d,'dist/'+d,{recursive:true,filter:(s)=>fs.statSync(s).isDirectory()||s.endsWith('.json')})}\"",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@types/multer": "^2.1.0",
    "@types/uuid": "^10.0.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.5.2",
    "multer": "^2.1.1",
    "uuid": "^11.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^20",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
